<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards">
	<description>WordPress Coding Standards for Ihumbak Semantic Search Plugin</description>

	<!-- Show progress and sniff codes -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Check all PHP files in directory tree by default. -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/phpstan-bootstrap.php</exclude-pattern>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		
		<!-- We use namespaces and modern file naming -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		
		<!-- Allow error_log for logging -->
		<exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
	</rule>

	<!-- Verify that everything in the global namespace is prefixed with a plugin-specific prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ihumbak_semantic_search"/>
				<element value="Ihumbak\SemanticSearch"/>
			</property>
		</properties>
	</rule>

	<!-- Allow direct database queries - we're using wpdb properly with escaping -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
	</rule>
	
	<!-- We use $wpdb->prepare() properly but with table name interpolation which is safe -->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
		<exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
	</rule>
	
	<!-- Allow short ternary for null coalescing -->
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>

	<!-- Minimum PHP version -->
	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>
